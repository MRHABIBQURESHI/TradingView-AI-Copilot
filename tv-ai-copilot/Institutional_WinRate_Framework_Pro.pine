//@version=5
indicator("Institutional Win-Rate Framework [Pro]", shorttitle="Inst. Framework [Pro]", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// =============================================================================
// TRADING WIN-RATE FRAMEWORK — INSTITUTIONAL DIRECTIONAL & RISK ENGINE (v5.0)
// Based on: Delta-Neutral Arbitrage & Institutional Directional Strategy (80%-85%)
//
// 1. Trend Baseline: Macro Daily / HTF EMA 200 Filter (Rule 1: Never counter-trend)
// 2. Fibonacci Golden Pocket: 0.618 - 0.65 Retracement Zone
// 3. Order Flow Imbalance & CVD Absorption Trap Engine (CVDreversal != DeltaP)
// 4. Statistical Extreme: Z-Score (Mean Reversion at +/- 2.5 to 3.0 Sigma)
// 5. Liquidity Sweeps / Stop Hunt Mechanics (Rule 2: Never enter without sweep)
// 6. Asymmetric Risk Scaling Protocol: Strict 1% Risk, TP1 1:1 (50% out + Breakeven), TP2 1:2 / 1:3
// 7. On-Chart HUD Table Dashboard with 5 Discipline Rules Checklist & EV Calculator
// =============================================================================

// --- 1. USER INPUT CONFIGURATIONS ---
grp_risk = "════ 1. CAPITAL & RISK PROTOCOL (1% STRICT) ════"
accountCapital  = input.float(10000.0, "Account Capital ($)", group=grp_risk, tooltip="Your trading capital balance")
riskPercent     = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk, tooltip="Fixed 1% capital risk (Rule 4)")
tp1Ratio        = input.float(1.0, "TP1 Ratio (50% Out + Breakeven)", minval=0.5, step=0.1, group=grp_risk)
tp2Ratio        = input.float(2.0, "TP2 Target Ratio", minval=1.5, step=0.5, group=grp_risk)
tp3Ratio        = input.float(3.0, "TP3 Runner Ratio", minval=2.0, step=0.5, group=grp_risk)

grp_macro = "════ 2. MACRO TREND FILTER (RULE 1) ════"
showMacroEma    = input.bool(true, "Show Macro Trend EMA", group=grp_macro)
macroTf         = input.timeframe("D", "Macro Timeframe", group=grp_macro, tooltip="Daily timeframe recommended by framework")
macroLength     = input.int(200, "Macro EMA Length", minval=50, group=grp_macro)

grp_fibo = "════ 3. FIBONACCI GOLDEN POCKET (0.618 - 0.65) ════"
showFiboZones   = input.bool(true, "Highlight Golden Pocket Zone", group=grp_fibo)
fiboPivotLen    = input.int(10, "Swing Pivot Lookback Length", minval=3, maxval=50, group=grp_fibo)

grp_stat = "════ 4. STATISTICAL EXTREME (Z-SCORE) ════"
showZScoreBands = input.bool(true, "Show Statistical Extreme Bands", group=grp_stat)
zPeriod         = input.int(20, "Z-Score Rolling Period", minval=5, group=grp_stat)
zExtremeThresh  = input.float(2.5, "Extreme Threshold (Sigma)", minval=1.5, maxval=4.0, step=0.1, group=grp_stat, tooltip="+/- 2.5 sigma = 98.7% probability boundary")
zFatTailThresh  = input.float(3.0, "Fat-Tail / Mean Reversion Band", minval=2.0, maxval=5.0, step=0.1, group=grp_stat)

grp_of = "════ 5. ORDER FLOW CVD & ABSORPTION TRAPS ════"
showAbsorption  = input.bool(true, "Show CVD Absorption Traps", group=grp_of)
volMultiplier   = input.float(1.5, "Volume Absorption Multiplier", minval=1.1, step=0.1, group=grp_of)

grp_sweep = "════ 6. LIQUIDITY SWEEP / STOP HUNTS (RULE 2) ════"
showSweeps      = input.bool(true, "Plot Stop Hunt Wick Sweeps", group=grp_sweep)
wickPercentMin  = input.float(45.0, "Min Wick % of Range for Hunt", minval=30.0, maxval=80.0, group=grp_sweep)

grp_hud = "════ 7. INSTITUTIONAL HUD DASHBOARD ════"
showDashboard   = input.bool(true, "Show Institutional HUD Table", group=grp_hud)
tablePos        = input.string("Top Right", "Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_hud)


// --- 2. MACRO TREND BASELINE (RULE 1) ---
// Formula: Pt > EMA200 (Daily) -> Longs Only | Pt < EMA200 -> Shorts Only
dailyEmaVal = request.security(syminfo.tickerid, macroTf, ta.ema(close, macroLength), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
isMacroBull = close > dailyEmaVal
isMacroBear = close < dailyEmaVal

plot(showMacroEma ? dailyEmaVal : na, "Macro EMA 200", color=isMacroBull ? color.new(#00e676, 20) : color.new(#ff5252, 20), linewidth=3)


// --- 3. SWING DETECTION & FIBONACCI GOLDEN POCKET ---
// Formula: P = High - [(High - Low) * 0.618]
pHigh = ta.pivothigh(high, fiboPivotLen, fiboPivotLen)
pLow  = ta.pivotlow(low, fiboPivotLen, fiboPivotLen)

var float lastSwingHigh = na
var float lastSwingLow  = na

if not na(pHigh)
    lastSwingHigh := high[fiboPivotLen]
if not na(pLow)
    lastSwingLow := low[fiboPivotLen]

swingDiff = lastSwingHigh - lastSwingLow
fib0_5    = lastSwingHigh - (swingDiff * 0.500)
fib0_618  = lastSwingHigh - (swingDiff * 0.618)
fib0_65   = lastSwingHigh - (swingDiff * 0.650)
fib0_786  = lastSwingHigh - (swingDiff * 0.786)

inGoldenPocketBull = (low <= fib0_618 and low >= fib0_786) or (close <= fib0_618 and close >= fib0_65)
inGoldenPocketBear = (high >= (lastSwingLow + (swingDiff * 0.618)) and high <= (lastSwingLow + (swingDiff * 0.786)))


// --- 4. STATISTICAL EXTREMES & Z-SCORE ENGINE ---
// Formula: Z = (Pt - mu_20) / sigma_20
zMean  = ta.sma(close, zPeriod)
zStDev = ta.stdev(close, zPeriod)
zScore = zStDev > 0 ? (close - zMean) / zStDev : 0.0

upper25 = zMean + (zStDev * zExtremeThresh)
upper30 = zMean + (zStDev * zFatTailThresh)
lower25 = zMean - (zStDev * zExtremeThresh)
lower30 = zMean - (zStDev * zFatTailThresh)

p_up30 = plot(showZScoreBands ? upper30 : na, "+3.0 Sigma Band", color=color.new(#ff1744, 40), style=plot.style_line)
p_up25 = plot(showZScoreBands ? upper25 : na, "+2.5 Sigma Band", color=color.new(#ff9100, 60), style=plot.style_dashed)
p_mean = plot(showZScoreBands ? zMean : na, "Statistical Mean", color=color.new(#787b86, 70), style=plot.style_line)
p_dn25 = plot(showZScoreBands ? lower25 : na, "-2.5 Sigma Band", color=color.new(#00e5ff, 60), style=plot.style_dashed)
p_dn30 = plot(showZScoreBands ? lower30 : na, "-3.0 Sigma Band", color=color.new(#00e676, 40), style=plot.style_line)

fill(p_up25, p_up30, color=color.new(#ff1744, 88), title="Upper Statistical Extreme Zone")
fill(p_dn25, p_dn30, color=color.new(#00e676, 88), title="Lower Statistical Extreme Zone")

isStatOversold   = zScore <= -zExtremeThresh
isStatOverbought = zScore >= zExtremeThresh


// --- 5. ORDER FLOW CVD & ABSORPTION TRAP DETECTION ---
// Intra-bar Delta estimate & CVD accumulation
barRange = high - low
candleBody = math.abs(close - open)
bullVolDelta = barRange > 0 ? volume * ((close - low) / barRange) : volume * 0.5
bearVolDelta = barRange > 0 ? volume * ((high - close) / barRange) : volume * 0.5
intraDelta   = bullVolDelta - bearVolDelta

var float cumVolumeDelta = 0.0
cumVolumeDelta += intraDelta

avgVol = ta.sma(volume, 20)
isHighVol = volume >= (avgVol * volMultiplier)

// Absorption Trap: Giant volume push but price cannot advance (limit wall absorption)
bullAbsorption = isHighVol and (close <= open or candleBody / math.max(barRange, 0.0001) < 0.25) and intraDelta < 0 and low <= lower25
bearAbsorption = isHighVol and (close >= open or candleBody / math.max(barRange, 0.0001) < 0.25) and intraDelta > 0 and high >= upper25


// --- 6. LIQUIDITY SWEEP & STOP HUNT MECHANICS (RULE 2) ---
// Stop hunt: Wick spikes beyond recent key swing, clears stops, rejects sharply
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
wickPctUp = barRange > 0 ? (upperWick / barRange) * 100 : 0
wickPctDn = barRange > 0 ? (lowerWick / barRange) * 100 : 0

sslSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and wickPctDn >= wickPercentMin
bslSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and wickPctUp >= wickPercentMin


// --- 7. MARKET REGIME FILTER (TRENDING vs RANGING) ---
// Solves Critical Review Section 9.9
adxVal = ta.rma(math.abs(ta.change(high) > ta.change(low) ? math.max(ta.change(high), 0) : 0), 14)
bbWidth = (upper25 - lower25) / math.max(zMean, 0.0001)
isTrending = bbWidth > ta.sma(bbWidth, 30) * 1.15
marketRegime = isTrending ? "Trending Expansion" : "Ranging / Mean Reversion"


// --- 8. INSTITUTIONAL 4-FILTER CONFLUENCE SIGNALS (A+ SETUPS) ---
// Filter 1: Macro Trend (EMA200)
// Filter 2: Golden Pocket Retracement
// Filter 3: Order Flow Absorption Trap or Sweep
// Filter 4: Statistical Extreme (Z-Score)
longFilter1 = isMacroBull
longFilter2 = inGoldenPocketBull or low <= fib0_618 or low <= lower25
longFilter3 = bullAbsorption or sslSweep or intraDelta > 0
longFilter4 = zScore <= -1.2 or isStatOversold
confluenceScoreLong = (longFilter1 ? 25 : 0) + (longFilter2 ? 25 : 0) + (longFilter3 ? 25 : 0) + (longFilter4 ? 25 : 0)

shortFilter1 = isMacroBear
shortFilter2 = inGoldenPocketBear or high >= (lastSwingLow + (swingDiff * 0.618)) or high >= upper25
shortFilter3 = bearAbsorption or bslSweep or intraDelta < 0
shortFilter4 = zScore >= 1.2 or isStatOverbought
confluenceScoreShort = (shortFilter1 ? 25 : 0) + (shortFilter2 ? 25 : 0) + (shortFilter3 ? 25 : 0) + (shortFilter4 ? 25 : 0)

aPlusLong  = longFilter1 and (sslSweep or bullAbsorption) and (longFilter2 or isStatOversold) and close > open
aPlusShort = shortFilter1 and (bslSweep or bearAbsorption) and (shortFilter2 or isStatOverbought) and close < open

// Plot Visual Signals
plotshape(aPlusLong, title="A+ Institutional Long", location=location.belowbar, color=#00e676, style=shape.labelup, size=size.normal, text="A+ BUY", textcolor=color.black)
plotshape(aPlusShort, title="A+ Institutional Short", location=location.abovebar, color=#ff1744, style=shape.labeldown, size=size.normal, text="A+ SELL", textcolor=color.white)

plotshape(showSweeps and sslSweep and not aPlusLong, title="Stop Hunt SSL Sweep", location=location.belowbar, color=#ffea00, style=shape.triangleup, size=size.tiny, text="⚡SSL SWEEP", textcolor=color.yellow)
plotshape(showSweeps and bslSweep and not aPlusShort, title="Stop Hunt BSL Sweep", location=location.abovebar, color=#ffea00, style=shape.triangledown, size=size.tiny, text="⚡BSL SWEEP", textcolor=color.yellow)


// --- 9. ASYMMETRIC SCALING & RISK PROTOCOL (HOW 80%+ IS LOCKED) ---
// Position Size = (Capital * 0.01) / (|Entry - SL| / Entry)
// TP1 at 1:1 RRR (50% Out + SL shifted to Entry -> Remaining Risk = 0)
// TP2 at 1:2 RRR (Remaining 50%)
var float tradeEntry = na
var float tradeSL    = na
var float tradeTP1   = na
var float tradeTP2   = na
var float tradeTP3   = na
var float tradePosSizeUsd = na
var string tradeSide = "NONE"

if aPlusLong
    tradeSide := "LONG"
    tradeEntry := close
    tradeSL    := math.min(low, not na(lastSwingLow) ? lastSwingLow : low) - (ta.atr(14) * 0.2)
    riskDist   = math.max(tradeEntry - tradeSL, syminfo.mintick * 10)
    tradeTP1   := tradeEntry + (riskDist * tp1Ratio)
    tradeTP2   := tradeEntry + (riskDist * tp2Ratio)
    tradeTP3   := tradeEntry + (riskDist * tp3Ratio)
    riskAmount = accountCapital * (riskPercent / 100.0)
    tradePosSizeUsd := riskAmount / (riskDist / tradeEntry)

if aPlusShort
    tradeSide := "SHORT"
    tradeEntry := close
    tradeSL    := math.max(high, not na(lastSwingHigh) ? lastSwingHigh : high) + (ta.atr(14) * 0.2)
    riskDist   = math.max(tradeSL - tradeEntry, syminfo.mintick * 10)
    tradeTP1   := tradeEntry - (riskDist * tp1Ratio)
    tradeTP2   := tradeEntry - (riskDist * tp2Ratio)
    tradeTP3   := tradeEntry - (riskDist * tp3Ratio)
    riskAmount = accountCapital * (riskPercent / 100.0)
    tradePosSizeUsd := riskAmount / (riskDist / tradeEntry)


// --- 10. INSTITUTIONAL HUD DASHBOARD TABLE ---
var table hud = na
if showDashboard
    tPos = tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : position.bottom_left
    hud := table.new(tPos, 2, 14, bgcolor=color.new(#10141f, 10), border_color=color.new(#242c40, 20), border_width=1)
    
    // Header
    table.cell(hud, 0, 0, "INSTITUTIONAL COPILOT", bgcolor=color.new(#1e293b, 0), text_color=#ffffff, text_size=size.small)
    table.cell(hud, 1, 0, "80%-85% FRAMEWORK", bgcolor=color.new(#1e293b, 0), text_color=#38bdf8, text_size=size.small)
    
    // Macro Trend (Daily EMA 200)
    table.cell(hud, 0, 1, "Macro Trend (Daily 200)", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 1, isMacroBull ? "BULLISH (Longs Only)" : "BEARISH (Shorts Only)", text_color=isMacroBull ? #00e676 : #ff5252, text_size=size.small)
    
    // Statistical Extreme (Z-Score)
    zColor = zScore <= -zExtremeThresh ? #00e676 : zScore >= zExtremeThresh ? #ff1744 : #94a3b8
    zState = zScore <= -zFatTailThresh ? "Extreme -3.0σ (Reversal)" : zScore <= -zExtremeThresh ? "Oversold -2.5σ (98.7%)" : zScore >= zFatTailThresh ? "Extreme +3.0σ (Reversal)" : zScore >= zExtremeThresh ? "Overbought +2.5σ (98.7%)" : "Normal Distribution"
    table.cell(hud, 0, 2, "Z-Score (20-period)", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(zScore, "#.##") + " | " + zState, text_color=zColor, text_size=size.small)
    
    // Fibonacci Golden Pocket
    fibStatus = inGoldenPocketBull ? "Inside Bullish 0.618 OTE" : inGoldenPocketBear ? "Inside Bearish 0.618 OTE" : "Out of Retracement"
    fibColor  = inGoldenPocketBull or inGoldenPocketBear ? #ffea00 : #94a3b8
    table.cell(hud, 0, 3, "Fib Golden Pocket", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 3, fibStatus, text_color=fibColor, text_size=size.small)
    
    // Order Flow / Absorption
    ofStatus = bullAbsorption ? "Whale Limit Buy Absorption!" : bearAbsorption ? "Whale Limit Sell Absorption!" : intraDelta > 0 ? "Buyer CVD Pressure" : "Seller CVD Pressure"
    ofColor  = bullAbsorption or bearAbsorption ? #ffea00 : intraDelta > 0 ? #00e676 : #ff5252
    table.cell(hud, 0, 4, "Order Flow Delta", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 4, ofStatus, text_color=ofColor, text_size=size.small)
    
    // Market Regime
    table.cell(hud, 0, 5, "Market Regime", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 5, marketRegime, text_color=isTrending ? #38bdf8 : #a78bfa, text_size=size.small)

    // Current Confluence Status
    confScore = isMacroBull ? confluenceScoreLong : confluenceScoreShort
    confGrade = confScore >= 100 ? "A+ SETUP (EXECUTE)" : confScore >= 75 ? "Grade A (High Prob)" : confScore >= 50 ? "Grade B (Wait Sweep)" : "NO SETUP (STAND DOWN)"
    confColor = confScore >= 100 ? #00e676 : confScore >= 75 ? #38bdf8 : confScore >= 50 ? #f59e0b : #ef4444
    table.cell(hud, 0, 6, "Confluence Score", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(confScore) + "% — " + confGrade, text_color=confColor, text_size=size.small)

    // Capital & Sizing
    table.cell(hud, 0, 7, "Account Capital / Risk", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 7, "$" + str.tostring(accountCapital, "#,###") + " (" + str.tostring(riskPercent, "#.#") + "% = $" + str.tostring(accountCapital * (riskPercent / 100), "#.##") + ")", text_color=#ffffff, text_size=size.small)

    // Last Planned Trade Sizing
    if not na(tradePosSizeUsd)
        table.cell(hud, 0, 8, "Position Size (" + tradeSide + ")", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 8, "$" + str.tostring(tradePosSizeUsd, "#,###.##") + " (" + str.tostring(tradePosSizeUsd / tradeEntry, "#.####") + " units)", text_color=#38bdf8, text_size=size.small)
        
        table.cell(hud, 0, 9, "TP1 (1:1 RRR - 50% Out)", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 9, str.tostring(tradeTP1, "#.##") + " -> Move SL to Breakeven!", text_color=#00e676, text_size=size.small)

        table.cell(hud, 0, 10, "TP2 Target (1:2 RRR)", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 10, str.tostring(tradeTP2, "#.##") + " (Remaining 50% Runner)", text_color=#00e5ff, text_size=size.small)
    else
        table.cell(hud, 0, 8, "Execution Plan", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 8, "Waiting for A+ Alignment", text_color=#64748b, text_size=size.small)
        table.cell(hud, 0, 9, "Rule 3 (No Setup)", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 9, "No Setup, No Trade", text_color=#f59e0b, text_size=size.small)
        table.cell(hud, 0, 10, "Rule 5 (Breakeven)", text_color=#94a3b8, text_size=size.small)
        table.cell(hud, 1, 10, "Lock Risk at TP1", text_color=#38bdf8, text_size=size.small)

    // Arbitrage Engine (Delta-Neutral Cash & Carry reference)
    table.cell(hud, 0, 11, "Delta-Neutral Arbitrage", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 11, "Spot + 1x Short | 12%-35% Est. APR", text_color=#e2e8f0, text_size=size.small)

    // Rules Checklist
    table.cell(hud, 0, 12, "Discipline Checklist", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 12, "5/5 Non-Negotiable Rules Active", text_color=#10b981, text_size=size.small)

    table.cell(hud, 0, 13, "Expected Value (EV)", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 13, "Math: +$800 / 100 Trades @ 1:2 RRR", text_color=#34d399, text_size=size.small)


// --- 11. TRADINGVIEW REAL-TIME ALERTS ---
alertcondition(aPlusLong, title="[Inst. Framework] A+ BUY Signal", message="⚡ Institutional A+ BUY Setup detected! Trend: Bullish, Z-Score extreme, Order flow absorption confirmed. Follow 1% sizing & TP1 Breakeven protocol.")
alertcondition(aPlusShort, title="[Inst. Framework] A+ SELL Signal", message="⚡ Institutional A+ SELL Setup detected! Trend: Bearish, Z-Score extreme, Order flow absorption confirmed. Follow 1% sizing & TP1 Breakeven protocol.")
alertcondition(sslSweep, title="[Inst. Framework] SSL Stop Hunt", message="⚠️ Sell-Side Liquidity Swept! Stop Hunt Wick rejection at Key Level.")
alertcondition(bslSweep, title="[Inst. Framework] BSL Stop Hunt", message="⚠️ Buy-Side Liquidity Swept! Stop Hunt Wick rejection at Key Level.")
alertcondition(isStatOversold, title="[Inst. Framework] Z-Score Oversold Extreme", message="📊 Statistical Extreme: Price at -2.5 Sigma boundary (98.7% distribution limit). Watch for mean reversion.")
alertcondition(isStatOverbought, title="[Inst. Framework] Z-Score Overbought Extreme", message="📊 Statistical Extreme: Price at +2.5 Sigma boundary (98.7% distribution limit). Watch for mean reversion.")
